ions": [{"_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 0}]}, {"stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": " Hardware and software engineers in your community. "}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "You're done!", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}], "type": "learning_skills"}], "id": 11, "type": "DWS", "template_override": 1, "questions": [{"_data": [{"contents": [{"type": "pdf", "content": "enpe8n4le01ob01re7pdf01.pdf"}], "type": "question"}], "responses": [{"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}], "id": 0}]}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"_data": [], "contents": [{"value": {"audiosrc": "enpe8n4le01ob01re2aud01", "coverimg": "enpe8n4le01ob01re2img01.jpg", "images": [{"time": "100", "image": "enpe8n4le01ob01re2img01.jpg", "id": 0, "text": "<span class=\"strong\">  Kate: </span>Excuse me, are you Randy Marshall?  <br />\n<span class=\"strong\">  Randy: </span> Yeah! I'm Randy. Who are you?  <br />\n<span class=\"strong\">  Kate: </span> Randy, don't you remember me? You make me feel like a cog in the machine! <br />\n<span class=\"strong\">  Randy: </span>Sorry, I don't. <br />\n<span class=\"strong\">  Kate: </span> I'm Kate Johnson, your university classmate. <br />\n<span class=\"strong\">  Randy: </span> Oh, yes! My apologies, Kate. Please, don't blow a fuse! How's everything going? <br />\n<span class=\"strong\">  Kate: </span> Well, I work as a hardware engineer. What about you? What do you do?  <br />\n<span class=\"strong\">  Randy: </span> Pretty much the same as you. I spend my days in front of a computer. But, in my case, I work as a software engineer.  <br />\n<span class=\"strong\">  Kate: </span>Really? What do you have to do in that field? <br />\n<span class=\"strong\">  Randy: </span> Well, I have to design particular programs, I research new applications, and I handle support all the time. In your case, what do you got to do?  <br />\n<span class=\"strong\">  Kate: </span> I have to check the hardware configuration of computers. I upgrade layouts and components to make computers work faster and in a more efficient way.  <br />"}, {"time": "49500", "image": "enpe8n4le01ob01re2img02.jpg", "id": 1, "text": "<span class=\"strong\">  Randy: </span> Hum, I see. So, hardware engineers are more functional than software engineers in the sense that you need to know how computers operate. <br />\n<span class=\"strong\">  Kate: </span> Exactly! And software engineers need to be more creative than hardware engineers because you make programs. <br />\n<span class=\"strong\">  Randy: </span>  That's it! Moreover, I think technical responsibilities are more important for you than programming responsibilities.  <br />\n<span class=\"strong\">  Kate: </span>  Yes! And, you are more skillful in research than us. <br />"}, {"time": "77300", "image": "enpe8n4le01ob01re2img03.jpg", "id": 2, "text": "<span class=\"strong\">  Randy: </span>You know, I make these comparisons because I want to work as an IT specialist. So, I need to be competitive in both fields; hardware and software.  </br>\n<span class=\"strong\">  Kate: </span> You're right! In addition, main duties and responsibilities of that job are related to networks and database management. Also, you have to assess the practicality of technology systems and, you need to keep up to date on technology advancements."}]}, "type": "slideshow"}], "type": "audio", "template_override": 1, "id": 1, "title": ""}, {"_data": [], "contents": [{"value": "escalera 01.jpg", "type": "img"}, {"value": "escalera 03.jpg", "type": "img"}, {"value": "escalera 04.jpg", "type": "img"}], "type": "static", "template_override": 1, "id": 2, "title": ""}], "id": 0, "type": "scholar"}]}